# Local secrets — DO NOT commit (listed in .gitignore)
# Copy to `.env` and fill values. Never paste keys into code or chat logs.

# DashScope / 百炼：Embedding（建库/检索）+ 默认 LLM（qwen-flash）
DASHSCOPE_API_KEY=

# Pay-as-you-go MaaS workspace (recommended when public free quota is exhausted)
# DASHSCOPE_COMPAT_BASE_URL=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_HTTP_API_URL=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/api/v1
DASHSCOPE_COMPAT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_HTTP_API_URL=https://dashscope.aliyuncs.com/api/v1

# Optional LLM override（一般可留空，默认跟 DashScope + qwen-flash）
# 若要用 DeepSeek：填 LLM_API_KEY / LLM_BASE_URL=https://api.deepseek.com / LLM_MODEL=deepseek-chat
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=qwen-flash

MODELSCOPE_CACHE_DIR=./models
SCENIC_DEMO_VIDEO_URL=
RUN_E2E=
SCENIC_EMBEDDING_MOCK=
